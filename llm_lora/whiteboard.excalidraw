      "seed": 1718141758,
      "version": 89,
      "versionNonce": 49414334,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763374602080,
      "link": null,
      "locked": false,
      "text": "Sei un assistente utile e accurato.\nRispondi solo utilizzando le\ninformazioni presenti nel contesto\nfornito.\nSe il contesto non contiene dati\nsufficienti per rispondere, dillo\nchiaramente e spiega brevemente\nperché.\nNon fare supposizioni, attieniti alle\ninformazioni nel contesto.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "K5P6nb9FaSwzn3PXXox83",
      "originalText": "Sei un assistente utile e accurato. Rispondi solo utilizzando le informazioni presenti nel contesto fornito.\nSe il contesto non contiene dati sufficienti per rispondere, dillo chiaramente e spiega brevemente perché.\nNon fare supposizioni, attieniti alle informazioni nel contesto.",
      "autoResize": true,
      "lineHeight": 1.25
    },
