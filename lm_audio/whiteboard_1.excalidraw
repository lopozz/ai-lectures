      "updated": 1790083253321,
      "link": null,
      "locked": false,
      "text": "Recreates a person’s voice from a short\naudio reference, allowing new text to be\nspoken with the same vocal identity and\ncharacteristics.",
      "fontSize": 17.865400465970197,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recreates a person’s voice from a short audio reference, allowing new text to be spoken with the same vocal identity and characteristics.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "yDOBLPTcshvVINi-nUpLi",
      "type": "text",
      "x": -2584.8930345180474,
      "y": 1384.0566324039746,
      "width": 356.93921454049797,
      "height": 111.65875291231374,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "O8gFFtCycOgYPT6wzNylf",
        "yIAn-8HzQQxwQYgyP0Qj9",
        "8Bd39yv_D_SjdQqx9jbEK"
      ],
      "frameId": null,
      "index": "b7q",
      "roundness": null,
      "seed": 9896359,
      "version": 1007,
      "versionNonce": 29186027,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790083253321,
      "link": null,
      "locked": false,
      "text": "Generates a new voice from a natural-\nlanguage description, defining\ncharacteristics such as tone,\npersonality, age, style, or speaking\nmanner.",
      "fontSize": 17.865400465970197,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Generates a new voice from a natural-language description, defining characteristics such as tone, personality, age, style, or speaking manner.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "X6CnjQp248EQLYB6Vf81M",
      "type": "text",
      "x": -2582.9788844681225,
      "y": 1551.225736764125,
      "width": 356.93921454049797,
      "height": 89.32700232985098,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "O8gFFtCycOgYPT6wzNylf",
        "yIAn-8HzQQxwQYgyP0Qj9",
        "8Bd39yv_D_SjdQqx9jbEK"
      ],
      "frameId": null,
      "index": "b7qG",
      "roundness": null,
      "seed": 1991989449,
      "version": 1031,
      "versionNonce": 734077579,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790083253321,
      "link": null,
      "locked": false,
      "text": "Adjusts how a voice delivers the text\nby modifying aspects such as emotion,\nintonation, rhythm, emphasis, or speaking\nstyle.",
      "fontSize": 17.865400465970197,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Adjusts how a voice delivers the text by modifying aspects such as emotion, intonation, rhythm, emphasis, or speaking style.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "R3y9_JfCWWdGWcTDF4w_R",
      "type": "text",
      "x": -2988.6559322843386,
      "y": 710.9687023558954,
      "width": 834.8985565038328,
      "height": 312.64450815447844,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "d5h_-TnC4JU2J5imPj15b",
        "UZwgDKJClwu6IIyUthe9a",
        "6pMWK7pyviwwMTEj0YZ8K",
        "p4HKp4x0qh9nFBiOEcKRS",
        "YWUC177HuUHcuL44I2GSz",
        "PQVuAip7zBGGcGSIdHDiv",
        "yIAn-8HzQQxwQYgyP0Qj9",
        "8Bd39yv_D_SjdQqx9jbEK"
      ],
      "frameId": null,
      "index": "b7qV",
      "roundness": null,
      "seed": 1024398737,
      "version": 2925,
      "versionNonce": 70424875,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790083253321,
      "link": null,
      "locked": false,
      "text": "The modern task of text-to-speech or TTS, is exactly the reverse of ASR; to map text:\n\n                                                Have a nice day!\n\nto an acoustic waveform:\n                            \n                                                   \n\n\n\n\n\nTTS is used in spoken language models that interact with people, for reading text out loud,\nfor games, and to produce speech for sufferers of neurological disorders",
      "fontSize": 17.865400465970197,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The modern task of text-to-speech or TTS, is exactly the reverse of ASR; to map text:\n\n                                                Have a nice day!\n\nto an acoustic waveform:\n                            \n                                                   \n\n\n\n\n\nTTS is used in spoken language models that interact with people, for reading text out loud, for games, and to produce speech for sufferers of neurological disorders",
      "autoResize": false,
      "lineHeight": 1.25
    },
