      "isDeleted": false,
      "boundElements": [],
      "updated": 1763996813129,
      "link": null,
      "locked": false,
      "text": " You can think of\nghosts as a\nfundamentally\ndifferent kind of\npoint in the space\nof possible\nintelligences. ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "P7WRLoTmlh4UsRl8zl_yH",
      "originalText": " You can think of ghosts as a fundamentally different kind of point in the space of possible intelligences. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
