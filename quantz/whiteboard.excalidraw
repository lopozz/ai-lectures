      "isDeleted": false,
      "boundElements": [],
      "updated": 1789027095060,
      "link": null,
      "locked": false,
      "text": "- awq is up to 4x than FP16 on a 4090\n- AWQ needs 10x less calibration data than GPTQ, and is more robust across datasets",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- awq is up to 4x than FP16 on a 4090\n- AWQ needs 10x less calibration data than GPTQ, and is more robust across datasets",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "VA_Mqq3A6Gd_DrFRaFqdv",
      "type": "text",
      "x": -4535.926320205692,
      "y": 8333.452467762474,
      "width": 103.18043518066406,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "jnjhwkwABcbg625VET2ze"
      ],
      "frameId": null,
      "index": "bP2",
