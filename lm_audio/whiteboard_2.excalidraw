      "text": "Moshi: a Speech-text Foundation model for Real-\ntime Dialogue",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Moshi: a Speech-text Foundation model for Real-time Dialogue",
      "autoResize": false,
      "lineHeight": 1.15,
