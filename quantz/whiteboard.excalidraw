      "text": "When Quantizatipn: Training and Inference ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When Quantizatipn: Training and Inference ",
      "autoResize": true,
