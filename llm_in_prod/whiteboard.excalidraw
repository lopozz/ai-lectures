      "text": "docker run --rm \\\n    --runtime nvidia \\\n    --name \"Llama-3.2-3B-Instruct\" \\\n    --gpus all \\\n    --ipc=host \\\n    -v ~/.cache/huggingface:/root/.cache/huggingface \\\n    -p 8003:8000 \\\n    vllm/vllm-openai:latest \\\n    --model \"unsloth/Llama-3.2-3B-Instruct\" \\\n    --dtype=bfloat16 \\\n    --tensor-parallel-size 1 \\\n    --max-model-len 500 \\ \n    --gpu-memory-utilization 0.9",
      "fontSize": 17.37142857142857,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "2zkTbyZRbERzpsTli6ty7",
