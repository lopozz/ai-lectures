      ],
      "frameId": null,
      "index": "b5VG",
      "roundness": null,
      "seed": 1885299024,
      "version": 981,
      "versionNonce": 1364517838,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763829994402,
      "link": null,
      "locked": false,
      "text": "The pre-training of the 7B Llama 2 model required Meta 184,320 GPU hours \non A100 GPUs (80GB), processing 2 trillion tokens. Running an 8xA100 cloud \nserver on AWS costs around $30 per hour. A rough estimate puts the total \ntraining cost of such an LLM at around $690,000\n\n\n\n\n\n\n\nYou can find LLM open weight base models on model hubs like Hugging Face",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The pre-training of the 7B Llama 2 model required Meta 184,320 GPU hours \non A100 GPUs (80GB), processing 2 trillion tokens. Running an 8xA100 cloud \nserver on AWS costs around $30 per hour. A rough estimate puts the total \ntraining cost of such an LLM at around $690,000\n\n\n\n\n\n\n\nYou can find LLM open weight base models on model hubs like Hugging Face",
      "autoResize": true,
      "lineHeight": 1.25
    },
