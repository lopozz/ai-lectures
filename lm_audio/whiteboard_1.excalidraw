      "link": "https://arxiv.org/pdf/2203.01941",
      "locked": false,
      "text": "Offline seq2seq",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Offline seq2seq",
      "autoResize": false,
      "lineHeight": 1.15,
