      "text": "Single Agent Systems",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 7,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Single Agent Systems",
