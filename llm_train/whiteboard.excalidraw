      "isDeleted": false,
      "boundElements": [],
      "updated": 1763823984041,
      "link": null,
      "locked": false,
      "text": "What is a language model ",
      "fontSize": 39.54285714285655,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What is a language model ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "N3ZAjByD2lrFpbfwGCMlO",
      "type": "text",
      "x": -1492.0382060836705,
      "y": -3322.4865894432214,
      "width": 772.5392456054688,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "JqRAawUpnNoXxMutuUkJV"
      ],
      "frameId": null,
      "index": "b85xV",
      "roundness": null,
      "seed": 380996191,
      "version": 1100,
      "versionNonce": 1711808613,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763995430436,
      "link": null,
      "locked": false,
      "text": "A Language Model (LM) is a machine learning model that tales a sequance of \nsymbols and learns their probabilistic relationship in the attempt to imitate it. \n    --> a LM assigns a probability distribution over possible next words \n        w conditioned on a history h.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A Language Model (LM) is a machine learning model that tales a sequance of \nsymbols and learns their probabilistic relationship in the attempt to imitate it. \n    --> a LM assigns a probability distribution over possible next words \n        w conditioned on a history h.",
      "autoResize": true,
      "lineHeight": 1.25
    },
