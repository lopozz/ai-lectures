      "updated": 1791873362271,
      "link": null,
      "locked": false,
      "text": "Evaluator-optimizer",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Evaluator-optimizer",
      "autoResize": true,
