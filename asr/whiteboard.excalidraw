    {
      "id": "GqtWGI4adcTjw4ahBc0tQ",
      "type": "text",
      "x": -662.2709977577433,
      "y": 6903.861606390318,
      "width": 284.45318603515625,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "_7LX0paOGWEjKbDGI8Bry",
        "Ld9xI_tsF-brHr8vnAfhB",
        "almf3daoHx5C6HjsH5xwC",
        "esA4URqSayE1tJcIzOKMq",
        "EA_tr5suNeOhWDvJz2_DF"
      ],
      "frameId": null,
      "index": "b3A",
