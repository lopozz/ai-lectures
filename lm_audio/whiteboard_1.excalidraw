    {
      "id": "fzor1YL6at5gu0n6s5ErL",
      "type": "text",
      "x": -1724.7634239629933,
      "y": 1860.0430387440929,
      "width": 1003.8980102539062,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "nAftxcV0HmVrNgrLTxti0",
        "F0yAnOH3yU_jna_75a3vK"
      ],
      "frameId": null,
      "index": "b7j",
      "roundness": null,
      "seed": 2024641097,
      "version": 5505,
      "versionNonce": 393162980,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790173103359,
      "link": null,
      "locked": false,
      "text": "Kokoro is an open-weight TTS model with 82 million parameters.\n\nKokoro keeps the synthesis backbone of StyleTTS 2, but turns it into a much simpler inference model\nby removing dynamic style generation and using precomputed voice/style embeddings instead.\nVoices\n    🇺🇸 American English\n    🇬🇧 British English\n    🇯🇵 Japanese\n    🇨🇳 Mandarin Chinese\n    🇪🇸 Spanish\n    🇫🇷 French\n    🇮🇳 Hindi\n    🇮🇹 Italian\n    🇧🇷 Brazilian Portuguese\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kokoro is an open-weight TTS model with 82 million parameters.\n\nKokoro keeps the synthesis backbone of StyleTTS 2, but turns it into a much simpler inference model by removing dynamic style generation and using precomputed voice/style embeddings instead.\nVoices\n    🇺🇸 American English\n    🇬🇧 British English\n    🇯🇵 Japanese\n    🇨🇳 Mandarin Chinese\n    🇪🇸 Spanish\n    🇫🇷 French\n    🇮🇳 Hindi\n    🇮🇹 Italian\n    🇧🇷 Brazilian Portuguese\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
