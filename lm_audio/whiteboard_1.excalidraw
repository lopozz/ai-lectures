      "seed": 190668773,
      "version": 518,
      "versionNonce": 1817185643,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790086344441,
      "link": null,
      "locked": false,
      "text": "A pooling layer is a kind of network layer that\ndownsamples and aggregates information that is\ndispersed among many vectors into fewer vectors.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A pooling layer is a kind of network layer that downsamples and aggregates information that is dispersed among many vectors into fewer vectors.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1790085095077,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "eAhyA9_rk9RBk-C7FU6HA",
      "type": "text",
      "x": 3920.741644187492,
      "y": 5771.934854062834,
      "width": 366.3175048828125,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jM6ssg04SazYFJK8_Ey4t"
      ],
      "frameId": null,
      "index": "b9O",
      "roundness": null,
      "seed": 1389501253,
      "version": 462,
      "versionNonce": 1835083787,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790086344441,
      "link": null,
      "locked": false,
      "text": "Nearest-neighbor interpolation is a simple\nmethod that assigns the value of the closest\nknown data point to an unknown location.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nearest-neighbor interpolation is a simple method that assigns the value of the closest known data point to an unknown location.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1790085095077,
      "labelPosition": null,
      "baseFontSize": null
    },
