    {
      "id": "Jt6DVRRopcrvfVYvjdzFK",
      "type": "text",
      "x": -1710.0092050234477,
      "y": 168.98508596420288,
      "width": 525.8140869140625,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
