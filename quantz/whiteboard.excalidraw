    {
      "id": "YKo7zckxoYlA3S7x5L8nB",
      "type": "text",
      "x": -12600.893666763188,
      "y": 4533.900089308703,
      "width": 285.5451965332031,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
