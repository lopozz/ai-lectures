    },
    {
      "id": "CIPgVJPW_WWnTOA5IsPt6",
      "type": "text",
      "x": -1950.157796959812,
      "y": 2325.419959368846,
      "width": 544.959536126863,
      "height": 90.605984956444,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "PoziTcCwsKlzKGuIIAMG8",
        "ezVh-g-eyHO1fgNRDC4f1"
      ],
      "frameId": null,
      "index": "b2g",
      "roundness": null,
      "seed": 1053416694,
      "version": 1760,
      "versionNonce": 327892778,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762333647744,
      "link": null,
      "locked": false,
      "text": "Human: \"Emily buys 3 apples and 2 oranges. Each\norange costs $2. The total cost of all the fruit is $13.\nWhat is the cost of apples?\"",
      "fontSize": 22.371848137393577,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Human: \"Emily buys 3 apples and 2 oranges. Each orange costs $2. The total cost of all the fruit is $13. What is the cost of apples?\"",
      "autoResize": false,
      "lineHeight": 1.35
    },
    {
      "id": "dE_J6zuRNogKf-VZTQ12p",
      "type": "text",
      "x": -2109.2627049659595,
      "y": 2457.701225382429,
      "width": 396.11826539769277,
      "height": 120.80797994192532,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "PoziTcCwsKlzKGuIIAMG8",
        "ezVh-g-eyHO1fgNRDC4f1"
      ],
      "frameId": null,
      "index": "b2h",
      "roundness": null,
      "seed": 1991167542,
      "version": 2046,
      "versionNonce": 1726859754,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762333647744,
      "link": null,
      "locked": false,
      "text": "Assistant: \"The answer is $3. This is\nbecause 2 oranges at $2 are $4 total.\nSo the 3 apples cost $9, and therefore\neach apple is 9/3 = $3\".",
      "fontSize": 22.371848137393577,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Assistant: \"The answer is $3. This is because 2 oranges at $2 are $4 total. So the 3 apples cost $9, and therefore each apple is 9/3 = $3\".",
      "autoResize": false,
      "lineHeight": 1.35
    },
    {
      "id": "TbxrB5Lor-56yxpI2Q6xC",
      "type": "text",
      "x": -1659.9617303292825,
      "y": 2455.003898811046,
      "width": 396.11826539769277,
      "height": 120.80797994192532,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "PoziTcCwsKlzKGuIIAMG8",
        "ezVh-g-eyHO1fgNRDC4f1"
      ],
      "frameId": null,
      "index": "b2i",
      "roundness": null,
      "seed": 1600362358,
      "version": 2281,
      "versionNonce": 724630698,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762333647744,
      "link": null,
      "locked": false,
      "text": "Assistant: \"The total cost of the\noranges is $4. 13 - 4 = 9, the cost of\nthe 3 apples is $9. 9/3 = 3, so each\napple costs $3. The answer is $3\".",
      "fontSize": 22.371848137393577,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Assistant: \"The total cost of the oranges is $4. 13 - 4 = 9, the cost of the 3 apples is $9. 9/3 = 3, so each apple costs $3. The answer is $3\".",
      "autoResize": false,
      "lineHeight": 1.35
    },
