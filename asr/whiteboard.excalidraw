    {
      "id": "e538U8z-MODD4UM7Xfi7e",
      "type": "text",
      "x": -3543.1866921269548,
      "y": 2643.1948285429976,
      "width": 228.0329132080078,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
