    {
      "id": "ZRNo2tPJPr6v64lwUKQtJ",
      "type": "text",
      "x": -1987.599922259651,
      "y": 12534.420778680023,
      "width": 1026.778076171875,
      "height": 1450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
