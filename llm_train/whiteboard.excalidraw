    {
      "id": "1R_H-z__DYQ3n0-bZVdRY",
      "type": "text",
      "x": 232.6598901571124,
      "y": 2206.335550202777,
      "width": 872.2200427861351,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
