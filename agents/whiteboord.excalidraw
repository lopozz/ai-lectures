    },
    {
      "id": "Bcd13_5aWL0x2yOO-9iKv",
      "type": "text",
      "x": -9099.517014979083,
      "y": 4859.299921464291,
      "width": 1026.778076171875,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Sh3yffsyJmYdM3ph_ex_L",
        "UNHWV1bu0drvmRo_lGkaG",
        "Nb1dgo7alNntX6Om3XIHG",
        "jv4cjiXw_PWp4mE3f6BhA",
        "tTkAmuPexzEmtxiuYFngA",
        "czyM5cb4o_YCtcniRBn_a",
        "LP0iKvAIEkDNRCbzo_b1P",
        "tIyfyQzcTckTZCuM3A5SF"
      ],
      "frameId": null,
      "index": "b7F",
      "roundness": null,
      "seed": 913925695,
      "version": 8840,
      "versionNonce": 8855473,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792409321299,
      "link": null,
      "locked": false,
      "text": "Routing classifies an input and directs it to a specialized followup task. This workflow allows for\nseparation of concerns, and building more specialized prompts. Without this workflow, optimizing for one\nkind of input can hurt performance on other inputs.\n\n\n\n\n\n\n\n\n\nRouting works well for complex tasks where there are distinct categories that are better handled\nseparately, and where classification can be handled accurately",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Routing classifies an input and directs it to a specialized followup task. This workflow allows for separation of concerns, and building more specialized prompts. Without this workflow, optimizing for one kind of input can hurt performance on other inputs.\n\n\n\n\n\n\n\n\n\nRouting works well for complex tasks where there are distinct categories that are better handled separately, and where classification can be handled accurately",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": 1791802801645,
      "baseFontSize": null
    },
