      "seed": 377979520,
      "version": 505,
      "versionNonce": 187647360,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763643866685,
      "link": null,
      "locked": false,
      "text": "For linear layer there is no need to\ndistinguish the elements of different\nrequests --> flat 2D tensor without\nbatch dimension\nTo perform attention in batch each\nrequest nedd exactly the same shape.\nIn this case:\n1. split the batched input tensor\n2. process each request individually\n3. merge the output tensor again\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For linear layer there is no need to distinguish the elements of different\nrequests --> flat 2D tensor without batch dimension\nTo perform attention in batch each request nedd exactly the same shape. In this case:\n1. split the batched input tensor\n2. process each request individually\n3. merge the output tensor again\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
