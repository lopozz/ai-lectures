    {
      "id": "CvnoI0dxFp7cq68hh8-Va",
      "type": "text",
      "x": -1505.2341547285832,
      "y": -2874.3603200575963,
      "width": 863.1166538900814,
      "height": 49.428571428570685,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "1uXwodmZjHX3JKYHxAFTN",
        "j2jSWjibIVfBdyOJrcXbP"
      ],
      "frameId": null,
