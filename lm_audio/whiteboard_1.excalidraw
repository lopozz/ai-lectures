      "updated": 1790169211894,
      "created": 1790160648153,
      "link": null,
      "locked": false,
      "text": "After the delay, generate\none audio frame and feed\nthat generated audio back\nat the next backbone step",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "After the delay, generate one audio frame and feed that generated audio back at the next backbone step",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
