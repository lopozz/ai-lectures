    {
      "id": "_UeBtvErvCXjwCgerjg1g",
      "type": "text",
      "x": 9235.38121501519,
      "y": 12722.875726580793,
      "width": 179.56808471679688,
      "height": 41.4,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
