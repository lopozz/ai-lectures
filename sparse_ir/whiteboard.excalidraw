      "updated": 1791388912757,
      "link": null,
      "locked": false,
      "text": "Italian BERT",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Italian BERT",
      "autoResize": true,
