      "updated": 1790705154925,
      "created": 1790504621026,
      "link": null,
      "locked": false,
      "text": "Moshi evaluates all the Mimi audio codebooks\nFor each codebook compute the cross-\nentropy on audio tokens.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Moshi evaluates all the Mimi audio codebooks\nFor each codebook compute the cross-entropy on audio tokens.",
