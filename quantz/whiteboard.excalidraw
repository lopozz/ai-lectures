    {
      "id": "0vdNBV1AhYlwL9MVduK-h",
      "type": "text",
      "x": 2122.450488039421,
      "y": 5137.076090392617,
      "width": 1026.778076171875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
