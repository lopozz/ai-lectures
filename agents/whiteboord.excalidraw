    {
      "id": "HH9Ko-CNNDdzqcuMhTcPm",
      "type": "text",
      "x": -8448.632937067967,
      "y": 3705.7233204344047,
      "width": 313.88409423828125,
      "height": 41.4,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [
        "nobepLrpgASLNKX11iweu"
      ],
      "frameId": null,
      "index": "b1j",
