      "seed": 179509346,
      "version": 221,
      "versionNonce": 1490052532,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789421407676,
      "link": null,
      "locked": false,
      "text": "Limitations of Learned Sparse Retrieval",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Limitations of Learned Sparse Retrieval",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "e0OoTPWvo-DxCo-tg2VxG",
      "type": "text",
      "x": 1135.3237202962237,
      "y": 1355.75,
      "width": 853.19921875,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "PkoCjZX4bsE54Cf-8mo9g"
      ],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 1861757374,
      "version": 362,
      "versionNonce": 849448756,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789421407676,
      "link": null,
      "locked": false,
      "text": "Index growth: Expansion adds terms to documents, potentially creating longer posting \n    lists and larger indexes.\n\nLatency: An expanded query can activate many terms. Poorly controlled sparsity can \n    make retrieval slower.\n\nTraining complexity: Strong models commonly depend on distillation, hard negatives and \n    carefully tuned regularisation.\n\nVocabulary restriction: Most learned sparse models can activate only terms in a fixed \n    tokenizer vocabulary.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Index growth: Expansion adds terms to documents, potentially creating longer posting \n    lists and larger indexes.\n\nLatency: An expanded query can activate many terms. Poorly controlled sparsity can \n    make retrieval slower.\n\nTraining complexity: Strong models commonly depend on distillation, hard negatives and \n    carefully tuned regularisation.\n\nVocabulary restriction: Most learned sparse models can activate only terms in a fixed \n    tokenizer vocabulary.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
