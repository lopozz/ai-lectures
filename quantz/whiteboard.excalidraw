    {
      "id": "Asb4CMVUsHUeZmVE6x8Ju",
      "type": "text",
      "x": -7944.741314246723,
      "y": 10730.249762349024,
      "width": 965.2591552734375,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [
        "QYyjiE1jTuPYgNPjkjufq"
      ],
      "frameId": null,
      "index": "bHF",
      "roundness": null,
      "seed": 1835155256,
      "version": 274,
      "versionNonce": 84287288,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788970621257,
      "link": null,
      "locked": false,
      "text": "Our entire GPTQ calibration data consists of 128 random 2048 token\nsegments from the C4 dataset (Raffel et al., 2020), i.e., excerpts from randomly crawled websites,\nwhich represents generic text data. We emphasize that this means that GPTQ does not see any\ntask-specific data, and our results thus remain actually “zero-shot”.\n\n\n- for quantization time take 4GPU/h to quantize BLOOM176B",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Our entire GPTQ calibration data consists of 128 random 2048 token\nsegments from the C4 dataset (Raffel et al., 2020), i.e., excerpts from randomly crawled websites,\nwhich represents generic text data. We emphasize that this means that GPTQ does not see any\ntask-specific data, and our results thus remain actually “zero-shot”.\n\n\n- for quantization time take 4GPU/h to quantize BLOOM176B",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "UWYmJxc2CvRX0yunvmjgH",
      "type": "text",
      "x": -7535.397665769626,
      "y": 10677.869305307056,
      "width": 103.18043518066406,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
