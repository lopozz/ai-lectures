    {
      "id": "y8t9rc--4BkUfYutxIPxX",
      "type": "text",
      "x": 153.7174032751891,
      "y": 1237.4970191201876,
      "width": 438.04876708984375,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "BMJDzbftjIR4WYqG8nNZI"
      ],
      "frameId": null,
      "index": "b6i",
