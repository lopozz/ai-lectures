      "created": 1791529761850,
      "link": null,
      "locked": false,
      "text": "The intuition is that a word appearing 100\ntimes in a document doesn’t make that\nword 100 times more likely to be relevant to\nthe meaning of the document",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The intuition is that a word appearing 100 times in a document doesn’t make that word 100 times more likely to be relevant to the meaning of the document",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
