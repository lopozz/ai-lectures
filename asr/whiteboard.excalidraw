      "isDeleted": false,
      "boundElements": [],
      "updated": 1789416511819,
      "link": null,
      "locked": false,
      "text": "KL Divergence",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "KL Divergence",
      "autoResize": true,
