    },
    {
      "id": "-h1mrZtiV8z0Z5l0XeEHo",
      "type": "text",
      "x": -1738.8265465244558,
      "y": 3796.603283279686,
      "width": 590.5355631510411,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "-_6R27V7Vfiygu78Vfny6"
      ],
      "frameId": null,
      "index": "b2o",
      "roundness": null,
      "seed": 2013595382,
      "version": 1694,
      "versionNonce": 1983276418,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762791165706,
      "link": null,
      "locked": false,
      "text": "Generated many solutions --> Take the correct ones -->\nTrain on them\nRepeat many, many times.\n\nReinforcement Learning discovers \"thinking\" and \"cognitive\nstrategies\".\nIt is emergent during the optimization, just in the process\nof solving math problems.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Generated many solutions --> Take the correct ones --> Train on them\nRepeat many, many times.\n\nReinforcement Learning discovers \"thinking\" and \"cognitive strategies\".\nIt is emergent during the optimization, just in the process of solving math problems.",
      "autoResize": false,
      "lineHeight": 1.25
    },
