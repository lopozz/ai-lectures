    {
      "id": "Egipy6Zgxn4i7jDCAf7W9",
      "type": "text",
      "x": 6625.346662863051,
      "y": 2565.5566092872423,
      "width": 805.6166538900814,
      "height": 49.428571428570685,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
