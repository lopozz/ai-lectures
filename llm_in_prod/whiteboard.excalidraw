    {
      "id": "E3eaTB89oEmKWMBSbi30P",
      "type": "text",
      "x": 1056.1053397285177,
      "y": 855.0203084184682,
      "width": 805.6166538900814,
      "height": 49.428571428570685,
      "angle": 0,
      "strokeColor": "#1971c2",
