      "text": "Training Budget Allocation",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Training Budget Allocation",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "id": "OLDodO9_48b9BXqD8-A39",
      "type": "image",
      "x": -3600.7747783774485,
      "y": 4235.447463126411,
      "width": 799.9999999999999,
      "height": 539,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 40,
      "groupIds": [
        "Z2kusg6BdtTecY1slvZ-z"
      ],
      "frameId": null,
      "index": "b3R6",
      "roundness": null,
      "seed": 699119266,
      "version": 185,
      "versionNonce": 777652130,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790933320168,
      "link": null,
      "locked": false,
      "status": "pending",
