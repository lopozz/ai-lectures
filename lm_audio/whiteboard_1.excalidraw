    {
      "id": "CFmr6ECo57KwF1aDLTOcG",
      "type": "image",
      "x": 2151.8844452805533,
      "y": 1637.5494468081172,
      "width": 589.3953488372094,
      "height": 264.0000000000001,
      "angle": 0,
      "strokeColor": "transparent",
