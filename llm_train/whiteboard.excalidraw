    {
      "id": "jxiScKCgxFLKUG--Qt1VL",
      "type": "text",
      "x": -1962.1739251371937,
      "y": 2588.5782536276515,
      "width": 29.7626713703085,
      "height": 37.088867399922904,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "PoziTcCwsKlzKGuIIAMG8",
        "ezVh-g-eyHO1fgNRDC4f1"
      ],
      "frameId": null,
      "index": "b2l",
      "roundness": null,
      "seed": 301138742,
      "version": 1783,
      "versionNonce": 1863091434,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762333647744,
      "link": null,
      "locked": false,
      "text": "❌",
