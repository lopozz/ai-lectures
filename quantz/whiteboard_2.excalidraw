    {
      "id": "K1wlilrGZ4VWcA5STZhA6",
      "type": "text",
      "x": -3959.669325187857,
      "y": 788.7827303886415,
      "width": 1707.273681640625,
      "height": 125.89999999999978,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
