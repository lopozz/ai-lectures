      "seed": 466578594,
      "version": 689,
      "versionNonce": 570982713,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763628204675,
      "link": null,
      "locked": false,
      "text": "        curl -X GET \"https://api.example.com/resource\" \\\n            -H \"Accept: application/json\" \\\n            -H \"Authorization: Bearer YOUR_API_TOKEN\"",
      "fontSize": 16,
