    {
      "id": "pPNRPA0fiS31mabXAXbEo",
      "type": "text",
      "x": -545.9340442475807,
      "y": 1950.1001542795361,
      "width": 910.0891723632812,
      "height": 625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "kxSITtWvotqdQwNa104y2",
        "cDfn5J6bqBkS8Nag1G1IL",
        "qN3fJJS-4yz6-ei8My_dy",
        "I9s25LxD2NqeFcvSdQ1G_",
        "41YBo0RqHs4crI1GHUmO_"
      ],
      "frameId": null,
      "index": "ag",
