    {
      "id": "J5CLp2Uw8Is7NWrfhduYK",
      "type": "text",
      "x": 2897.882189669464,
      "y": 3028.946312145583,
      "width": 372.3284946017792,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9t",
