      "text": "Parallelization",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Parallelization",
      "autoResize": true,
      "lineHeight": 1.15,
