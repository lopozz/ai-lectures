    {
      "id": "zhRWEdeinrIVhaUCxf9Ix",
      "type": "text",
      "x": -2114.7959033959487,
      "y": 3309.013465012411,
      "width": 839.7200427861349,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "dt5UlJkTJ-RISGLP2Ik63"
      ],
      "frameId": null,
      "index": "b6XV",
