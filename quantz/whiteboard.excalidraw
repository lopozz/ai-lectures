      "updated": 1789421702582,
      "link": null,
      "locked": false,
      "text": "The expected error from Round(·) does not change: since\nthe round function maps a floating-point number to an\ninteger, the error is roughly uniformly distributed from\n[0,0.5], resulting in an average error of 0.25 independently.\nWe denite this RoundErr",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The expected error from Round(·) does not change: since the round function maps a floating-point number to an integer, the error is roughly uniformly distributed from [0,0.5], resulting in an average error of 0.25 independently.\nWe denite this RoundErr",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
