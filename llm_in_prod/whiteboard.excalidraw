      "type": "image",
      "x": 2373.397430273585,
      "y": 411.84936590345944,
      "width": 570.9495614035086,
      "height": 194.87499999999997,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "#b2f2bb",
