    {
      "id": "rvj7EezzUQq5egZg-iNzR",
      "type": "text",
      "x": 988.6678096650053,
      "y": -2769.24432901642,
      "width": 271.16851806640625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
