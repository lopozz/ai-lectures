    {
      "id": "rg6GBD8KglY7gZiTj0WMJ",
      "type": "text",
      "x": -1915.664609091621,
      "y": 1748.5550165448954,
      "width": 910.0891723632812,
      "height": 1725,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "rbEoEBu2mkVGacgl57JZE",
        "bBsJ3Mg2CVYrP4NPpAbya",
        "c3ePegDpquu-9JTbTURKf"
      ],
      "frameId": null,
      "index": "aZ",
