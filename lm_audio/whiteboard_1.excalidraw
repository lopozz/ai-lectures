    {
      "id": "hY7fNrdnrKBhFeDgUX6Th",
      "type": "text",
      "x": -3918.5896003100615,
      "y": 3411.5960775784088,
      "width": 805.6166538900814,
      "height": 41.4,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
