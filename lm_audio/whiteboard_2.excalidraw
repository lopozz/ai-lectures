      "text": "Mimi Audio Codec",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mimi Audio Codec",
      "autoResize": false,
      "lineHeight": 1.15,
