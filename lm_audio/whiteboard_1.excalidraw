      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "5WL6zM29UfAzU4ojRBj5C",
        "hQdnQw0ySuhoZtGcxU8_f"
      ],
      "frameId": null,
      "index": "b2b",
      "roundness": null,
      "seed": 929987793,
      "version": 3166,
      "versionNonce": 1929335388,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790173367387,
      "link": null,
      "locked": false,
      "text": "Zero-shot voice cloning is an approximation. It captures the general tone and timbre of a speaker’s voice, \nbut it doesn’t reproduce the full expressive range: speaking speed, phrasing, vocal quirks, and the subtleties \nof prosody.\n\nIf you just want a different voice and are fine with the same delivery patterns, zero-shot is usually good enough. \nBut the speech will still follow the model’s style, not the speaker’s.\n\nFor anything more personalized or expressive, you need training with methods like LoRA to truly capture how \nsomeone speaks.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Zero-shot voice cloning is an approximation. It captures the general tone and timbre of a speaker’s voice, \nbut it doesn’t reproduce the full expressive range: speaking speed, phrasing, vocal quirks, and the subtleties \nof prosody.\n\nIf you just want a different voice and are fine with the same delivery patterns, zero-shot is usually good enough. \nBut the speech will still follow the model’s style, not the speaker’s.\n\nFor anything more personalized or expressive, you need training with methods like LoRA to truly capture how \nsomeone speaks.",
      "autoResize": true,
      "lineHeight": 1.25
    },
