    {
      "id": "lu3QtNsW4SpBxxU_FdU8d",
      "type": "text",
      "x": 3256.804336988651,
      "y": 5774.334369532702,
      "width": 407.9661865234375,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jM6ssg04SazYFJK8_Ey4t"
      ],
      "frameId": null,
      "index": "b9N",
