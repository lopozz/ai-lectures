      "seed": 972614091,
      "version": 1911,
      "versionNonce": 363379373,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788800653797,
      "link": null,
      "locked": false,
      "text": "- Static post-training quantization\n- 0.1% to 1% of weights have a critical influece so they do not quantize those\n- these are called salient weights and are identified during calibration by looking at the activatioins\n- awq is up to 4x than FP16 on a 4090\n- AWQ needs 10x less calibration data than GPTQ, and is more robust across datasets\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Static post-training quantization\n- 0.1% to 1% of weights have a critical influece so they do not quantize those\n- these are called salient weights and are identified during calibration by looking at the activatioins\n- awq is up to 4x than FP16 on a 4090\n- AWQ needs 10x less calibration data than GPTQ, and is more robust across datasets\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
