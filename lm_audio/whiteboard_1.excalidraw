      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "AH7AvFJUtCMtsIP81UGYZ",
      "type": "text",
      "x": 4858.417503162791,
      "y": 1398.458808641797,
      "width": 926.7504882812497,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "xEhfRAO-iq8t9ipVqaIUs",
        "KgY-5Uynn38ykww_ljwq4"
      ],
      "frameId": null,
      "index": "b9V",
      "roundness": null,
      "seed": 322882652,
      "version": 4663,
      "versionNonce": 11694820,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790149896919,
      "link": null,
      "locked": false,
      "text": "In a classical cascade:\n\n\n\n\n\n\n\n\n\n\n\n\neach component is usually treated as an independent sequence-to-sequence problem.\n    ==> A complete input is needed before producing output. \n\nThis creates additional latency between stages.\n\nFor TTS, for example:\n\n                          [text text text text text] [audio audio audio...]\n                         └─────── input ───────┘└─── output ────┘",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In a classical cascade:\n\n\n\n\n\n\n\n\n\n\n\n\neach component is usually treated as an independent sequence-to-sequence problem.\n    ==> A complete input is needed before producing output. \n\nThis creates additional latency between stages.\n\nFor TTS, for example:\n\n                          [text text text text text] [audio audio audio...]\n                         └─────── input ───────┘└─── output ────┘",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1790086980807,
      "labelPosition": null,
      "baseFontSize": null
    },
