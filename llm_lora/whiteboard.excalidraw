    {
      "id": "vLVenE8g8S0QkqKUVlQc8",
      "type": "text",
      "x": -3488.629445856146,
      "y": -2076.8079877306523,
      "width": 770.6166538900814,
      "height": 49.428571428570685,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
