    },
    {
      "id": "OLDodO9_48b9BXqD8-A39",
      "type": "image",
      "x": -3600.7747783774485,
      "y": 4235.447463126411,
      "width": 799.9999999999999,
      "height": 539,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
