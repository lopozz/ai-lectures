      "text": "Properties of Outliers",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Properties of Outliers",
      "autoResize": true,
      "lineHeight": 1.15,
