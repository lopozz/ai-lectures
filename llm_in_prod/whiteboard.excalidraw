      "versionNonce": 1165785683,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763713320434,
      "link": null,
      "locked": false,
      "text": "Time-to-first-token (TTFT): The time it takes for an LLM serving system to generate the first token \nin response to a user request.\nThroughput: The number of completed requests per second processed by an LLM serving system.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Time-to-first-token (TTFT): The time it takes for an LLM serving system to generate the first token \nin response to a user request.\nThroughput: The number of completed requests per second processed by an LLM serving system.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
