        "q6AxoQdXmcfwZw3AFDlW4",
        "0SdD_6dTTZkiDfCbdeSGQ"
      ],
      "frameId": null,
      "index": "b2I",
      "roundness": null,
      "seed": 1642600556,
      "version": 396,
      "versionNonce": 1059091948,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789376975116,
      "link": null,
      "locked": false,
