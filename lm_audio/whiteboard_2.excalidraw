      "created": 1790710659333,
      "link": null,
      "locked": false,
      "text": "prompt: \"only record what the user says.\" The model writes the user's words on\nthe action channel with a fixed 2-chunk delay (320 ms). This teaches the model\nto track when the user says each word.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "prompt: \"only record what the user says.\" The model writes the user's words on the action channel with a fixed 2-chunk delay (320 ms). This teaches the model to track when the user says each word.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
