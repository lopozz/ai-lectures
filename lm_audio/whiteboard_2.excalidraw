    {
      "id": "QbT2K5FmbULNQ4lpB42kd",
      "type": "text",
      "x": 5836.299579403171,
      "y": 5773.855679927303,
      "width": 230.256103515625,
      "height": 41.4,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
