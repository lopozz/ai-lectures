    {
      "id": "Jt6DVRRopcrvfVYvjdzFK",
      "type": "text",
      "x": -3268.342538356781,
      "y": 883.9850859642029,
      "width": 525.8140869140625,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
