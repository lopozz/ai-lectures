    {
      "id": "jw1rWDAMiWcdIRv_Y_lvS",
      "type": "text",
      "x": 3677.1068326159134,
      "y": -195.73403251039548,
      "width": 175.4640655517578,
      "height": 41.4,
      "angle": 0,
