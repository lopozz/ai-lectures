    {
      "id": "CtvCOfebUuRpPIfZoWmAh",
      "type": "image",
      "x": -2159.6783163649425,
      "y": 126.30974169629826,
      "width": 531.7499999999998,
      "height": 241.31853872770822,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
