    },
    {
      "id": "CyFJ9-KsgUuTriVFL5LPH",
      "type": "text",
      "x": 4583.538691140995,
      "y": 3716.334480864372,
      "width": 72.6759033203125,
      "height": 34.06547376331651,
      "angle": 0,
      "strokeColor": "#1e1e1e",
