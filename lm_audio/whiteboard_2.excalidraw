      "updated": 1790711049820,
      "created": 1790710704418,
      "link": null,
      "locked": false,
      "text": "prompt: \"only record what the assistant says.\" The model writes its own words\non the action channel at the chunk where each word is actually heard. This is\nneeded because the text token inside the speech channel is always placed at the\nstart of a chunk, even if the sound comes later, so it carries no precise timing.\nThis task ties the model's own voice to the action clock.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "prompt: \"only record what the assistant says.\" The model writes its own words on the action channel at the chunk where each word is actually heard. This is needed because the text token inside the speech channel is always placed at the start of a chunk, even if the sound comes later, so it carries no precise timing. This task ties the model's own voice to the action clock.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
