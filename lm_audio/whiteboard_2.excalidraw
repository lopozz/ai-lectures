    {
      "id": "cR43dn5GFD68szfOmTPva",
      "type": "text",
      "x": 2896.395680472964,
      "y": 4160.970173833499,
      "width": 642.60302734375,
      "height": 560,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "zKC-sFxtQ7vzBd_Rb-HFc"
      ],
      "frameId": null,
      "index": "b22",
      "roundness": null,
      "seed": 615070697,
      "version": 989,
      "versionNonce": 1728095802,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790505714608,
      "created": 1790234978865,
      "link": null,
      "locked": false,
      "text": "                         ┌─────────────────────────────┐\n                         │                                                   │\nUSER ───────►  │           AUDIO-LANGUAGE MODEL       │────────► 🔊\n                         │                  (LFM2.5-Audio)              │\n                         │                                                   │\n                         └──────────────┬──────────────┘\n                                                    │\n                                                    │\n                                            USER SPEAKS \n                                                    │\n                                                    ▼\n                                      ┌────────────────┐\n                                      │                            │\n                                      │       Interrupt /       │\n                                      │          Barge-in        │\n                                      │                            │\n                                      └───────┬────────┘\n                                                    │\n                                                    ▼\n                                              Stop current\n                                              generation\n                                                    │\n                                                    ▼\n                                              Process new\n                                              audio input\n                                                    │\n                                                    ▼\n                                         Continue interaction",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "                         ┌─────────────────────────────┐\n                         │                                                   │\nUSER ───────►  │           AUDIO-LANGUAGE MODEL       │────────► 🔊\n                         │                  (LFM2.5-Audio)              │\n                         │                                                   │\n                         └──────────────┬──────────────┘\n                                                    │\n                                                    │\n                                            USER SPEAKS \n                                                    │\n                                                    ▼\n                                      ┌────────────────┐\n                                      │                            │\n                                      │       Interrupt /       │\n                                      │          Barge-in        │\n                                      │                            │\n                                      └───────┬────────┘\n                                                    │\n                                                    ▼\n                                              Stop current\n                                              generation\n                                                    │\n                                                    ▼\n                                              Process new\n                                              audio input\n                                                    │\n                                                    ▼\n                                         Continue interaction",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
