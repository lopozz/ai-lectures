    {
      "id": "9ZUn5LR_QAYOe-qdQW0Qi",
      "type": "text",
      "x": -10496.794737025726,
      "y": 1571.878706074589,
      "width": 505.745361328125,
      "height": 125.89999999999978,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bDy",
      "roundness": null,
      "seed": 1735834696,
      "version": 584,
      "versionNonce": 1513796936,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788957880467,
      "link": null,
      "locked": false,
      "text": "LLM.int8()",
      "fontSize": 109.47826086956503,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LLM.int8()",
