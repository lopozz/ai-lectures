    {
      "id": "JgaWKALhIPQkvq80t5Q8M",
      "type": "text",
      "x": -8654.25674209588,
      "y": 10859.756158080427,
      "width": 965.2591552734375,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
