    {
      "id": "7eWL5RWKglCt18l2ZJc6h",
      "type": "image",
      "x": 560.7441150347395,
      "y": 4536.2321159044905,
      "width": 777.4098360655735,
      "height": 361.9999999999999,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "45n-F1xZYFG1WM6kCdXvl"
      ],
      "frameId": null,
      "index": "b0x",
      "roundness": null,
      "seed": 1980639518,
      "version": 327,
      "versionNonce": 1756673516,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789251336223,
      "link": null,
