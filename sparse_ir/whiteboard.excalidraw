      "text": "Bidirectional Encoder Representations from Transformers",
      "fontSize": 36,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bidirectional Encoder Representations from Transformers",
