    {
      "id": "GfMlARuBLh9KzlVM7kj9W",
      "type": "text",
      "x": 934.8946843412432,
      "y": -2194.6466656963935,
      "width": 1056.9991455078125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "SxhcHfLQ-UwD-m__qTp3s"
      ],
      "frameId": null,
      "index": "b1ml",
      "roundness": null,
      "seed": 1927868671,
      "version": 4090,
      "versionNonce": 924351330,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763374053099,
      "link": null,
      "locked": false,
      "text": "Generate a synthetic dataset by distillation. LLM distillation is a technique to transfer knowledge from a \nlarge, complex language model (the \"teacher\") to a smaller, more efficient model (the \"student\")\n    - Questions that appear topically related to the context but are actually unanswerable from it.\n        These questions are generated to stay on-theme so that the model can’t rely on superficial cues to \n        detect irrelevance. It has to truly recognize that the needed information is missing.\n    - Answers that do not attempt to fabricate knowledge, but instead explicitly acknowledge the lack of \nevidence and explain why the question cannot be answered from the given context.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Generate a synthetic dataset by distillation. LLM distillation is a technique to transfer knowledge from a \nlarge, complex language model (the \"teacher\") to a smaller, more efficient model (the \"student\")\n    - Questions that appear topically related to the context but are actually unanswerable from it.\n        These questions are generated to stay on-theme so that the model can’t rely on superficial cues to \n        detect irrelevance. It has to truly recognize that the needed information is missing.\n    - Answers that do not attempt to fabricate knowledge, but instead explicitly acknowledge the lack of \nevidence and explain why the question cannot be answered from the given context.",
      "autoResize": true,
      "lineHeight": 1.25
    },
