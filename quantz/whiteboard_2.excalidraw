      "updated": 1790941233710,
      "link": null,
      "locked": false,
      "text": "FP32",
      "fontSize": 27.252379010653208,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "hjJDKADgxFWXEvLf7jFQY",
      "originalText": "FP32",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ty8ZTIRXZq1OiETerJwyN",
      "type": "text",
      "x": 4850.8788658623325,
      "y": 3415.6289777319103,
      "width": 474.5718587239569,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#40c057",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [
        "y1tTasXsINfyczLwjAXyr"
      ],
      "frameId": null,
      "index": "b8y",
      "roundness": null,
      "seed": 1675887550,
      "version": 236,
      "versionNonce": 916902562,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790941233710,
      "link": null,
      "locked": false,
      "text": "FP32 was the standard training baseline before\nmixed precision became common.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FP32 was the standard training baseline before mixed precision became common.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "qxZ2Xh7X5Lq506HATZYhQ",
      "type": "text",
      "x": 4892.764153147184,
      "y": 3567.7123110652433,
      "width": 416.38220214843756,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#40c057",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [
        "y1tTasXsINfyczLwjAXyr"
      ],
      "frameId": null,
      "index": "b8yV",
      "roundness": null,
      "seed": 263278526,
      "version": 167,
      "versionNonce": 20459106,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790941233710,
      "link": null,
      "locked": false,
      "text": "NVIDIA’s Megatron-LM work trained GPT-\nstyle models up to 8.3B parameters using\nmixed-precision training.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NVIDIA’s Megatron-LM work trained GPT-style models up to 8.3B parameters using mixed-precision training.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "VF2idRiEtk0dQADk0s5Zm",
      "type": "text",
      "x": 4937.108216826561,
      "y": 3703.12897773191,
      "width": 523.1910400390625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#40c057",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [
        "y1tTasXsINfyczLwjAXyr"
      ],
      "frameId": null,
      "index": "b8z",
      "roundness": null,
      "seed": 134323874,
      "version": 242,
      "versionNonce": 1890062882,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790941233710,
      "link": null,
      "locked": false,
      "text": "DeepSeek explicitly says it designed an FP8 mixed-\nprecision training framework and used it to pretrain\nV3 on 14.8T tokens.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DeepSeek explicitly says it designed an FP8 mixed-precision training framework and used it to pretrain V3 on 14.8T tokens.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "g6WX8UWn3Y207vexJsBcU",
      "type": "text",
      "x": 4999.3963535472185,
      "y": 3846.87897773191,
      "width": 455.018310546875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#40c057",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 80,
      "groupIds": [
        "y1tTasXsINfyczLwjAXyr"
      ],
      "frameId": null,
      "index": "b90",
      "roundness": null,
      "seed": 258741054,
      "version": 170,
      "versionNonce": 2011528674,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790941233710,
      "link": null,
      "locked": false,
      "text": "The 2025 paper reports training a 7B model\npredominantly in FP4, including weights,\nactivations and gradients, on up to 200B\ntokens, with performance comparable to its\nBF16 baseline.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The 2025 paper reports training a 7B model predominantly in FP4, including weights, activations and gradients, on up to 200B tokens, with performance comparable to its BF16 baseline.",
      "autoResize": false,
      "lineHeight": 1.25
    },
