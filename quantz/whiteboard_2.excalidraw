    {
      "id": "faNa_eggMIX08n5S3a4GK",
      "type": "image",
      "x": 5782.006177727821,
      "y": 4605.155018858162,
      "width": 726.0000000000001,
      "height": 207.7166666666667,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
