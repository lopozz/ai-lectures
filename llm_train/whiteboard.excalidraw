    {
      "id": "t3QHbJuqH63-jbg-flUTu",
      "type": "text",
      "x": 357.1568879080405,
      "y": 518.1062543000967,
      "width": 651.696533203125,
      "height": 614.8915797498422,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "yUI--T0jwbm1ufHwfd9qM"
      ],
      "frameId": null,
      "index": "b6Wx",
      "roundness": null,
      "seed": 876685744,
      "version": 1300,
      "versionNonce": 740052069,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763995488107,
      "link": null,
      "locked": false,
      "text": "Mitigation #1 - Finetune (NEXT LECTURE)\n=> Use model interrogation to discover model's knowledge, \nand fine tune on a new training dataset with \nknowledge-based refusals in cases where the model doesn't \nknow, i.e. train the model to reconize when it doesn't know\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nMitigation #2 - Tools\n=> Allow the model to search on the web",
      "fontSize": 22.35969380908517,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mitigation #1 - Finetune (NEXT LECTURE)\n=> Use model interrogation to discover model's knowledge, \nand fine tune on a new training dataset with \nknowledge-based refusals in cases where the model doesn't \nknow, i.e. train the model to reconize when it doesn't know\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nMitigation #2 - Tools\n=> Allow the model to search on the web",
      "autoResize": true,
      "lineHeight": 1.25
    },
