    {
      "id": "GGzK4J9bpbQ9LUMFhOtEv",
      "type": "text",
      "x": 8742.893364510384,
      "y": 479.1752927039597,
      "width": 980.3690185546875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Ug2u_iTuRf-awJbBAryo_",
        "02BSE9iJJtMFdNzf9fitB",
        "8KwRJpDqrkhjshyw1jzKi",
        "etuDlL0AvnqBVOoeA3ajY"
      ],
      "frameId": null,
      "index": "b3Y",
      "roundness": null,
      "seed": 1726201436,
      "version": 5791,
      "versionNonce": 661601892,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790709433523,
      "link": null,
      "locked": false,
      "text": "OpenAI introduced \"function calling\" as an API feature in June 2023, with the gpt-3.5-turbo-0613\nand gpt-4-0613 models.\n\nThe idea is that developers can now describe functions to the model, and have it choose to output\na JSON object containing arguments to call those functions.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "OpenAI introduced \"function calling\" as an API feature in June 2023, with the gpt-3.5-turbo-0613 and gpt-4-0613 models.\n\nThe idea is that developers can now describe functions to the model, and have it choose to output a JSON object containing arguments to call those functions.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1790705956870,
      "labelPosition": null,
      "baseFontSize": null
    },
