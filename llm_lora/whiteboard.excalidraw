    {
      "id": "-Yyu1FGEZNwbPdSZqXm5k",
      "type": "text",
      "x": -3498.1745891621854,
      "y": -1107.4695856173844,
      "width": 805.6166538900814,
      "height": 49.428571428570685,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
