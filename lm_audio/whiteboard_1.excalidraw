    {
      "id": "JXVzimodG9FxIAEf2yDpD",
      "type": "text",
      "x": 11822.248514811195,
      "y": 2983.199405255773,
      "width": 1158.1190185546875,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "KYuIV7kDDBjCEx_jORaOL",
        "hQdnQw0ySuhoZtGcxU8_f"
      ],
      "frameId": null,
      "index": "b2Zl",
      "roundness": null,
      "seed": 1891379934,
      "version": 3499,
      "versionNonce": 326890716,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790173367387,
      "link": null,
      "locked": false,
      "text": "Vocabulary letters like ‘p’ or ‘a’ are already a useful model of the sounds of human speech. However, the pronunciation \nof a word are usually represented with phones\n\n\n\n\n\n\n\n\n\n\n\nA good baseline in the target language should be able to generate quality speech sounds for the specific phones.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Vocabulary letters like ‘p’ or ‘a’ are already a useful model of the sounds of human speech. However, the pronunciation \nof a word are usually represented with phones\n\n\n\n\n\n\n\n\n\n\n\nA good baseline in the target language should be able to generate quality speech sounds for the specific phones.",
      "autoResize": true,
      "lineHeight": 1.25
    },
