      "updated": 1790171880352,
      "link": "https://aclanthology.org/2023.ijcnlp-demo.3.pdf",
      "locked": false,
      "text": "Throughput is the product between Real-\nTime Factor and batch size. \nWhisper-Streaming does not allow for\nbatching so it always uses batch size = 1",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Throughput is the product between Real-Time Factor and batch size. \nWhisper-Streaming does not allow for batching so it always uses batch size = 1",
      "autoResize": false,
      "lineHeight": 1.25
    },
