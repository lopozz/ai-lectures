      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [
        "R3QIfvyVtxf0rk1vT8Oc3"
      ],
      "frameId": null,
      "index": "b8r",
